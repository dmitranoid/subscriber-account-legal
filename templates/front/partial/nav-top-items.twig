{#
/contract      Персональная информация
/connections   Точки учета
/contract/sendreadings  Передать показания
/docs          Документы
/payments      Счета и оплаты
/consultation           Получить консультацию
/logout                 Выйти
#}

{% set nav = {
    contract: {title: "Договор", link: "/contract", icon: "fas fa-file-contract"},
    connections: {title: "Точки учета", link: "/connections", icon: "fas fa-map-marked-alt"},
    sendreadings: {title: "Передать показания", link: "/sendreadings", icon: "fas fa-file-signature"},
    payments: {title: "Счета и оплаты", link: "/payments", icon: "fas fa-file-invoice-dollar"},
    docs: {title: "Документы", link: "/docs", icon: "fas fa-file"},
    logout: {title: "Выйти", link: "/logout", icon: "fas fa-sign-out-alt"},
} %}
{#//    chat: {title: "Получить консультацию", link: "/chat", icon: "/img/icons/assistant.svg"},#}



<ul class="navbar-nav ml-auto">
    {% for item in nav %}
    <li class="nav-item">
        <a class="nav-link" href="{{ item.link }}">
            <i class="{{ item.icon }}"></i>
            {{ item.title }}
        </a>
    </li>
    {% endfor %}
</ul>
