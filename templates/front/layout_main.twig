{% extends 'front/blank.twig' %}

{% block body %}

<div id="wrap" class="d-flex flex-column">

<nav class="navbar navbar-expand-lg navbar-dark sticky-top scrolling-navbar primary">
    <a class="navbar-brand brestenergofontlogo" href="https://brestenergo.by">
        <img src="/img/brenergo-logo-small.png" class="d-inline-block align-center logo" alt="">
        Брестэнерго
    </a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#basicExampleNav"
    aria-controls="basicExampleNav" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="basicExampleNav">
    {% include 'front/partial/nav-top-items.twig' %}
  </div>
</nav>





<main role="main">
    <div class="container py-5">
       <div class="text-white pt-5">
           <h1 class="title text-uppercase">{{ block('title') }}</h1>
       </div>
       <div class="white my-5 p-4 rounded">
           {% block content %}
                content here
            {% endblock %}
       </div>
    </div>
</main>





<footer class="page-footer primary mt-auto">
  <div class="footer-copyright text-center py-3">
    {% include 'front/partial/footer-content.twig' %}
  </div>
</footer>


</div>

{%  endblock %}