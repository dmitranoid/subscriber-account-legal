{% extends 'front/layout_main.twig' %}

{% block title %}Счета и оплаты{% endblock %}

{% block content %}
    {% if contract.npp1 %}
        {% set orgName = contract.npp1+" "+contract.npp2 %}
    {% else %}
        {% set orgName = contract.np1 %}
    {% endif %}

    <div class="contract">
        <h5>Договор  №{{ contract.kp }}, {{ orgName }}</h5>
    </div>
<div class="info-block">
    <p>Задолженность на {{ 'now'|date('d.m.Y') }} : <span class="text-bold">{{ debtInfo.invoicesSum.sumTotal - debtInfo.paymentsSum.sumTotal }}</span></p>
</div>
    <table class="table contract-paydocs">
    <thead>
    <tr>
        <th>дата</th>
        <th>расчетный период</th>
        <th>документ</th>
        <th>выставлено, руб.</th>
        <th>оплачено, руб.</th>
    </tr>
    </thead>
    <tbody>
    {% for doc in docList %}
    <tr class="">
        <td>{{ doc.date|date('d.m.Y') }}</td>
        <td>{{ doc.period_m }}.{{ doc.period_y }}</td>
        <td>{{ doc.doctype }} {{ doc.docno }}</td>
        <td>{% if doc.sumInv %}{{ doc.sumInv|number_format(2, '.', ' ') }}{% endif %}</td>
        <td>{% if doc.sumPay %}{{ doc.sumPay|number_format(2, '.', ' ') }}{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}