{% extends 'front/layout_main.twig' %}

{% block title %}Данные о договоре{% endblock %}

{% block content %}

    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <tbody>
            <tr>
                <th>Договор №</th>
                <td>{{ contract.contractNo }}</td>
            </tr>
            <tr>
                <th>Дата заключения</th>
                <td>{{ contract.date|date('d.m.Y') }}</td>
            </tr>
            <tr>
                <th>УНП:</th>
                <td>{{ contract.unp }}</td>
            </tr>
            <tr>
                <th>Название организации</th>
                <td>{{ contract.name }}</td>
            </tr>
            <tr>
                <th>Юридический адрес</th>
                <td>{{ contract.addressLegal }}</td>
            </tr>
            <tr>
                <th>Расчетный счёт</th>
                <td>{{ contract.bank }} {{ contract.paybank }}</td>
            </tr>
            <tr>
                <th>Руководитель</th>
                <td>{{ contract.fio }}</td>
            </tr>
            <tr>
                <th>Ответственный за электрохозяйство</th>
                <td>{{ contract.fio }}</td>
            </tr>
            <tr>
                <th>Менеджер от электросетей</th>
                <td>{{ contract.manager }}</td>
            </tr>

            </tbody>
        </table>
    </div>

{% endblock %}