{% extends 'front/layout_main.twig' %}

{% block title %}Данные о договоре{% endblock %}

{% block content %}
{% if contract.npp1 %}
{% set orgName = contract.npp1 ~ " " ~ contract.npp2 %}
{% else %}
{% set orgName = contract.np1 %}
{% endif %}

<div class="table-responsive">
    <table class="table table-hover table-bordered">
        <tbody>
            <tr>
                <th>Договор №</th>
                <td>{{ contract.kp }}</td>
            </tr>
            <tr>
                <th>Дата заключения</th>
                <td>{{ contract.datd|date('d.m.Y') }}</td>
            </tr>
            <tr>
                <th>УНП:</th>
                <td>{{ contract.kodni }}</td>
            </tr>
            <tr>
                <th>Название организации</th>
                <td>{{ orgName }}</td>
            </tr>
            <tr>
                <th>Юридический адрес</th>
                <td>{{ contract.tip_np }} {{ contract.adres2 }} {{ contract.tip_ul }} {{ contract.adres3 }} {{ contract.tip_kv }} {{ contract.adres4 }}</td>
            </tr>
            <tr>
                <th>Руководитель</th>
                <td>{{ contract.fio }}</td>
            </tr>
            <tr>
                <th>Ответственный за электрохозяйство</th>
                <td>{{ contract.fio }}</td>
            </tr>
        </tbody>
    </table>
</div>

{% endblock %}