{% extends 'front/layout_main.twig' %}

{% block title %}Финансы{% endblock %}

{% block content %}
    <div class="contract">
        <h5>Договор №{{ contract.contractNo }}, {{ contract.name }}</h5>
    </div>
    <div class="alert alert-warning" role="alert">
        <p>Состояние расчетов на {{ debtInfo.date|date('d.m.Y') }}:<span class="text-bold"
                                                                         style="margin-left: 1rem;">{% if debtInfo.sum >0 %}задолженность {% else %}переплата{% endif %}{{ debtInfo.sum }} руб.</span>
        </p>
    </div>
    <table class="table contract-paydocs">
        <thead>
        <tr>
            <th>дата</th>
            <th>расчетный период</th>
            <th>документ</th>
            <th>выставлено, руб.</th>
            <th>оплачено, руб.</th>
        </tr>
        </thead>
        <tbody>
        {% for doc in docList %}
            <tr class="">
                <td>{{ doc.date|date('d.m.Y') }}</td>
                <td>{{ doc.period|date('m') }}.{{ doc.period|date('Y') }}</td>
                <td>{{ doc.doctype }} {{ doc.docno }}</td>
                <td>{% if doc.sumDt %}{{ doc.sumDt|number_format(2, '.', ' ') }}{% endif %}</td>
                <td>{% if doc.sumKt %}{{ doc.sumKt|number_format(2, '.', ' ') }}{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}