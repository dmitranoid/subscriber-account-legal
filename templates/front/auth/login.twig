{% extends 'front/blank.twig' %}
{% block title %}Личный кабинет - Авторизация{% endblock %}

{% block body %}
<div class="row h-100 justify-content-center align-items-center">
    <div class="col-6 col-md-6 col-sm-8">
        <form class="border border-light p-5" method="post" action="/login" role="form">
            <p class="h4 mb-4 text-center">Вход в личный кабинет</p>
            <label for="loginName">Логин</label>
            <input type="text" id="loginName" class="form-control mb-4" name="login" placeholder="">
            <label for="loginPass">Пароль</label>
            <input type="password" id="loginPass" class="form-control mb-4" name="password" placeholder="">

            <div class="d-flex justify-content-between">
                <div>
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="defaultLoginFormRemember">
                        <label class="custom-control-label" for="defaultLoginFormRemember">Запомнить меня</label>
                    </div>
                </div>
                <div>
                    <a href="">Забыли пароль?</a>
                </div>
            </div>

            <button class="btn btn-info btn-block my-4" type="submit">Войти</button>
        </form>
    </div>
    </div>
{% endblock %}