{% extends 'front/layout_main.twig' %}

{% block title %}Точка учета{% endblock %}

{% set connectionTypes= {'1':'показания', '2':'расчет по индексам', '3':'мощность', '4':'сумматор'} %}

{% block content %}
    {% if contract.npp1 %}
        {% set orgName = contract.npp1 ~ " " ~ contract.npp2 %}
    {% else %}
        {% set orgName = contract.np1 %}
    {% endif %}



<h4 class="underline"><b>Договор <u>№{{ contract.kp }}</u></b></h4>
<h5>{{ orgName }}</h5>
<div class="table-responsive">
    <table class="table table-hover table-bordered">
        <tbody>
            <tr>
                <th>Абонент</th>
                <td>{{ abonent.naim }}</td>
            </tr>
            <tr>
                <th>Наименование ТУ</th>
                <td>{{ connection.naim }}</td>
            </tr>
            <tr>
                <th>Способ расчетов</th>
                <td>{{ connectionTypes[connection.sr] }}</td>
            </tr>
            <tr>
                <th>Тариф</th>
                <td>{{ connection.tarnaim }}</td>
            </tr>
        </tbody>
    </table>
</div>



<h4 class="underline"><b>Прибор учета</b></h4>
<div class="table-responsive">
    <table class="table table-hover table-bordered">
        <tbody>
            <tr>
                <th>Тип прибора</th>
                <td>{{ connection.tsch }}</td>
            </tr>
            <tr>
                <th>Заводской номер</th>
                <td>{{ connection.nst }}</td>
            </tr>
            <tr>
                <th>Дата установки</th>
                <td>{{ connection.datu ? connection.datu|date('d.m.Y') : '-' }}</td>
            </tr>
            <tr>
                <th>Коэфф. трансформации</th>
                <td>{{ connection.ktt }}</td>
            </tr>
        </tbody>
    </table>
</div>






<h4 class="underline"><b>История показаний</b></h4>
<div class="table-responsive ">
    <table class="table table-hover  table-sm">
        <thead class="text-center thead-light">
            <tr>
                <th>Период</th>
                <th>Показание</th>
                <th>Потребление</th>
            </tr>
        </thead>
        <tbody class="text-center">
        {% for rd in readingsHistory %}
            <tr>
                <td>{{ rd.rp_part_m }}.20{{ rd.rp_part_y }}</td>
                <td>{{ rd.tpok }}</td>
                <td>{{ rd.consumption }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>



{% endblock %}