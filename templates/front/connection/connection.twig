{% extends 'front/layout_main.twig' %}

{% block title %}Точка учета{% endblock %}

{% set connectionTypes= {'1':'показания', '2':'расчет по индексам', '3':'мощность', '4':'сумматор'} %}

{% block content %}
    <div class="contract">
        <h5>Договор №{{ contract.contractNo }}, {{ contract.name }}</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <tbody>
            <tr>
                <th>Абонент</th>
                <td>{{ abonent.abonentNo }}. {{ abonent.name }}</td>
            </tr>
            <tr>
                <th>Наименование точки учета</th>
                <td>{{ connection.name }}</td>
            </tr>
            <tr>
                <th>Способ расчетов</th>
                <td>{{ connectionTypes[connection.calcMode] }}</td>
            </tr>
            <tr>
                <th>Тариф</th>
                <td>{{ connection.tariffName }}</td>
            </tr>
            </tbody>
        </table>
    </div>

    <h4 class="underline"><b>Прибор учета</b></h4>
    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <tbody>
            <tr>
                <th>Тип прибора</th>
                <td>{{ connection.counter.model }}</td>
            </tr>
            <tr>
                <th>Заводской номер</th>
                <td>{{ connection.counter.serialNo }}</td>
            </tr>
            <tr>
                <th>Дата установки</th>
                <td>{{ connection.counter.installDate ? connection.counter.installDate|date('d.m.Y') : '-' }}</td>
            </tr>
            <tr>
                <th>Коэффициент трансформации</th>
                <td>{{ connection.counter.coeffTr }}</td>
            </tr>
            </tbody>
        </table>
    </div>


    <h4 class="underline"><b>История показаний</b></h4>
    <div class="table-responsive ">
        <table class="table table-hover  table-sm">
            <thead class="text-center thead-light">
            <tr>
                <th>Период</th>
                <th>Показание</th>
                <th>Потребление</th>
            </tr>
        </thead>
        <tbody class="text-center">
        {% for rd in readingsHistory %}
            <tr>
                <td>{{ rd.period|date('m.Y') }}</td>
                <td>{{ rd.value|format('0.0') }}</td>
                <td>{{ rd.consumption|format('0.0') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>



{% endblock %}