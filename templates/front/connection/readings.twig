{% extends 'front/layout_main.twig' %}

{% block title %}Передача показаний приборов учета{% endblock %}

{% block content %}

    {% if contract.npp1 %}
        {% set orgName = contract.npp1 ~ " " ~ contract.npp2 %}
    {% else %}
        {% set orgName = contract.np1 %}
    {% endif %}

    <div class="contract">
        <h5>Договор №{{ contract.kp }}, {{ orgName }}</h5>
        <br>
        <h5>Ввод показаний за период: {{ "now-5 days"|date('m.Y') }}</h5>
    </div>

    <div class="alert alert-warning" role="alert">
        Показания вносятся с 25 по 05 числа месяца.<br>
        Все показания должны быть заполнены, даже если по прибору учета не было расхода.
        {% if (readings is not empty) and (not isSavedReadings) %}<p class="text-error">Вы уже внесли показания в
            текущем месяце !</p>
        {% endif %}
    </div>

    {% set disabledReadings = ((readings|length) and (not isSavedReadings)) ? 'disabled':'' %}

    <table class="table abonents table-readings">
        <thead>
        <tr>
            <th>номер прибора учета</th>
            <th>наименование</th>
            <th>предыдущее<br> показание</th>
            <th>расход за<br> предыдущий месяц</th>
            <th>текущее<br> показание</th>
        </tr>
        </thead>
        <tbody>
        {% for ab in abonentsList %}
            <tr class="abonent">
                <td colspan="5">абонент: {{ ab.nab }} {{ ab.naim }} {{ ab.address }}</td>
            </tr>
            {% for conn in ab.connections %}
                {% set cntname = 'cnt-' ~ ab.kp ~ '-' ~ ab.nab ~ '-' ~ conn.nst | replace({'.':'_'}) %}
                <tr class="connection">
                    <td>{{ conn.nst }}</td>
                    <td>{{ conn.naim }}</td>
                    <td>{{ conn.ppok }}</td>
                    <td>{{ conn.mrasp }}</td>
                    <td><input type="text" class="input-inline readings-value" {{ disabledReadings }} name="{{ cntname }}"
                               value="{{ attribute(readings, cntname) }}" data-prevr="{{ conn.ppok }}"
                               data-pras="{{ conn.mrasp }}">
                        <i class="fas fa-exclamation-triangle" style="visibility: hidden;"></i>
                    </td>
                </tr>
            {% endfor %}
        {% endfor %}
        </tbody>
    </table>
    <div style="margin:1rem 0;">
        <div class="divider"></div>
        <button class="btn btn-primary btn-lg half-width savereadings " {{ disabledReadings }} onclick="savereadings()"
                title="Сохранить данные и продолжить их ввод позднее">
            <i class="icon icon-time"></i>
            Сохранить
        </button>

        <button class="btn btn-primary btn-lg half-width sendreadings " {{ disabledReadings }} onclick="sendreadings()"
                title="Подписать и отправить данные для принятия к расчету">
            <i class="icon icon-share"></i>
            Подписать и передать показания
        </button>
    </div>
{% endblock %}

{% block js_code %}
    <script>

        list = document.querySelectorAll(".readings-value");
        for (var i = 0; i < list.length; i++) {
            list[i].addEventListener("blur", readingInputOnExit);
        }

        function readingInputOnExit(event) {
            let el = event.target;
            prevr = el.dataset.prevr;
            pras = el.dataset.pras;
            curr = el.value;
            // console.log(prevr, pras, curr);
            icon = el.parentElement.querySelector('i');
            icon.style.visibility = 'visible';

            // не заполнено
            if (el.value.length === 0) {
                icon.style.color = 'orange';
                icon.classList.add("fa-exclamation-triangle");
                icon.classList.remove("fa-check");
                icon.title="обязательно для заполнения"
                return;
            }
            // отмечаем если показания отличаются больше чем в 2 раза в любую сторону
            if ((curr - prevr > pras * 2)||(curr - prevr < pras / 2)) {
                icon.style.color = 'orange';
                icon.classList.add("fa-exclamation-triangle");
                icon.classList.remove("fa-check");
                icon.title="показания потребления предыдущего месяца отличаются более чем в 2 раза"
            } else {
                icon.style.color = 'green';
                icon.classList.remove("fa-exclamation-triangle");
                icon.classList.add("fa-check");
                icon.title="показания в пределах прошлого месяца"
            }
        }
    </script>
{% endblock %}