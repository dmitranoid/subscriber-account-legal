{% extends 'front/layout_main.twig' %}

{% block title %}Точки учета{% endblock %}

{% set connectionTypes= {'1':'показания', '2':'расчет по индексам', '3':'мощность', '4':'сумматор'} %}

{% block content %}

    <h4 class="underline"><b>Договор <u>№{{ contractInfo.contractNo }}</u></b></h4>
    <h5>{{ contractInfo.name }}</h5>

    <div class="table-responsive mt-3">
        <table class="table table-hover table-bordered table-sm">
            <thead class="text-center thead-light">
            <tr>
                <th>№</th>
                <th>Наименование</th>
                <th>Заводской №</th>
                <th>Дата установки</th>
                <th>Способ расчета</th>
                <th>Коэфф. трансф.</th>
                <th>Дата поверки</th>
                <th>Показания</th>
                <th><i class="fas fa-info"></i></th>
            </tr>
            </thead>
            <tbody>

            {% for ab in abonentsList %}
                <tr class="mdb-color lighten-5">
                    <th class="text-center"><b>{{ ab.abonentNo }}</b></th>
                    <td><b>{{ ab.name }}</b></td>
                    <td colspan="7">
                        <div class="d-flex">
                            <b>{{ ab.address }}</b>
                            <a class="hover-link ml-auto mr-2" href="https://maps.google.com/?q={{ ab.address }}"
                               target="_blank" title="Посмотреть на карте">
                                На карте<i class="fas fa-map-marked-alt ml-2"></i>
                            </a>
                        </div>
                    </td>
                </tr>

                {% for conn in connectionsList %}
                    {% if (conn.abonentNo == ab.abonentNo) %}
                        <tr>
                            <td></td>
                            <td>{{ conn.name }}</td>
                            <td>{{ conn.counter.serialNo }}</td>
                            <td>{{ conn.counter.installDate ? conn.counter.installDate|date("d.m.Y") : '-' }}</td>
                            <td>{{ connectionTypes[conn.calcMode] }}</td>
                            <td>{{ conn.counter.coeffTr == 1 ? '-' :  conn.counter.coeffTr }}</td>
                            <td>{{ conn.counter.checkoutDate ? conn.counter.checkoutDate|date("m.Y") : '-' }}</td>
                            <td>{{ conn.counter.lastValue|default('-') }}</td>
                            <td>
                                <a class="hover-link" href="/connection/{{ connectionLink(ab.abonentNo, conn.name) }}"
                                   title="Подробнее о точке учета">
                                    Подробнее<i class="fas fa-angle-double-right ml-2"></i>
                                </a>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}