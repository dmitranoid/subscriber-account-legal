{% extends 'front/layout_main.twig' %}

{% block title %}Точки учета{% endblock %}

{% set connectionTypes= {'1':'показания', '2':'расчет по индексам', '3':'мощность', '4':'сумматор'} %}

{% block content %}
    {% if contract.npp1 %}
        {% set orgName = contract.npp1+" "+contract.npp2 %}
    {% else %}
        {% set orgName = contract.np1 %}
    {% endif %}
<div class="contract">
    <h5>Договор  №{{ contract.kp }}, {{ orgName }}</h5>
</div>

    <table class="table table-responsive abonents">
    <thead>
    <tr>
        <th scope="col">№</th>
        <th scope="col">наименование</th>
        <th scope="col">заводской №</th>
        <th scope="col">дата установки</th>
        <th scope="col">способ расчета</th>
        <th scope="col">коэфф.трансф.</th>
        <th scope="col">дата поверки</th>
        <th scope="col">показания</th>
    </tr>
    </thead>
    <tbody>
    {% for ab in abonentsList %}
        {% set address = ab.tip_np ~ ab.name_np ~ ', ' ~ ab.tip_ul ~ ab.name_ul ~ ', ' ~ (ab.dom ? 'д. ') ~ ab.dom ~ ' ' ~ ab.korpus %}
    <tr class="abonent">
        <th scope="row">{{ ab.nab }}</th>
        <td>{{ ab.naim }}</td>
        <td colspan=6> <a href="https://maps.google.com/?q={{ address }}" target="_blank" title="Посмотреть на карте"><i class="icon icon-location"></i></a>&nbsp
            {{ address }}
        </td>
    </tr>
    {% for conn in ab.connections %}
    <tr class="connection clickable-row" data-href="/connection/{{ ab.nab }}-{{ conn.naim_url }}">
        <td><a title="подробнее о точке учета">{#<i class="icon icon-location"></i>#}</a></td>
        <td>{{ conn.naim }}</td>
        <td>{{ conn.nst }}</td>
        <td>{{ conn.datu ? conn.datu|date("d.m.Y") : '' }}</td>
        <td>{{ connectionTypes[conn.sr] }}</td>
        <td>{{ conn.ktt==1 ? '' :  conn.ktt }}</td>
        <td>{{ conn.kvpov }} {{ conn.kvpov ? 'кв.' : '' }} {{ conn.godpov }}</td>
        <td>{{ conn.ppok ? conn.ppok : '' }}</td>
    </tr>
    {% endfor %}
    {% endfor %}
    </tbody>
</table>

{% endblock %}