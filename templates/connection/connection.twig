{% extends 'layout_main.twig' %}

{% block title %}Точка учета{% endblock %}

{% set connectionTypes= {'1':'показания', '2':'расчет по индексам', '3':'мощность', '4':'сумматор'} %}

{% block content %}
<div class="contract">
    <h5>Договор  №{{ contract.kp }}, {{ contract.npp1 }} {{ contract.npp2 }}</h5>
</div>
    <div class="content col-9 ">
    <div class="form-group d-inline-block">
        <label class="form-label">абонент</label>
        <input class="form-input" name="contractNo" readonly value="{{ abonent.naim }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">наименование ТУ</label>
        <input class="form-input" name="contractDate" readonly value="{{ connection.naim }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">способ расчетов</label>
        <input class="form-input" name="calc_method" readonly value="{{ connectionTypes[connection.sr] }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">тариф</label>
        <input class="form-input" name="tu_tariff" value="{{ connection.tarnaim }}">
    </div>
    <div class="clearfix"></div>
    <div><h4>Прибор учета</h4></div>
    <div class="form-group d-inline-block">
        <label class="form-label">тип прибора</label>
        <input class="form-input" name="org_name" readonly value="{{ connection.tsch }} ">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">заводской номер</label>
        <input class="form-input" name="org_address" readonly value="{{ connection.nst }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">дата установки</label>
        <input class="form-input" name="contract.datu" readonly value="{{ connection.datu ? connection.datu|date('d.m.Y') : '-' }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">коэфф. трансформации</label>
        <input class="form-input" name="org_director" readonly value="{{ connection.ktt }}">
    </div>
    <div><h4>История показаний</h4></div>
    <table class="table readings-history">
    <thead>
    <tr>
        <th>период</th>
        <th>показание</th>
        <th>потребление</th>
    </tr>
    </thead>
    <tbody>
    {% for rd in readingsHistory %}
    <tr class="reading">
        <td> {{ rd.rp_part_m }}.20{{ rd.rp_part_y }}</td>
        <td>{{ rd.tpok }}</td>
        <td>{{ rd.consumption }}</td>
    </tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}