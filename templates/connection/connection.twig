{% extends 'layout_main.twig' %}

{% block title %}Точка учета{% endblock %}

{% set connectionTypes= {'1':'показания', '2':'мощность', '3':'сумматор'} %}

{% block content %}
<div class="contract">
    <h5>Договор  №{{ contract.kp }}, {{ contract.npp1 }} {{ contract.npp2 }}</h5>
</div>
    <div class="content col-9 ">
    <div class="form-group d-inline-block">
        <label class="form-label">Абонент:</label>
        <input class="form-input" name="contractNo" value="{{ abonent.naim }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">Наимнование точки учета:</label>
        <input class="form-input" name="contractDate" value="{{ connection.naim }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">Тип прибора:</label>
        <input class="form-input" name="org_name" value="{{ connection.ts }} ">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">Заводской номер:</label>
        <input class="form-input" name="org_address" value="{{ connection.nst }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">Дата установки:</label>
        <input class="form-input" name="contract.kodni" value="{{ connection.datu|date('d.m.Y') }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">Тип расчетов:</label>
        <input class="form-input" name="org_director" value="{{ connectionTypes[connection.sr] }}">
    </div>
    <div class="form-group d-inline-block">
        <label class="form-label">Коэффициент трансформации:</label>
        <input class="form-input" name="org_director" value="{{ connection.ktt }}">
    </div>
    <div><h4>История показаний прибора учета:</h4></div>
    <table class="table readings-history">
    <thead>
    <tr>
        <th>период</th>
        <th>показание</th>
        <th>потребление</th>
    </tr>
    </thead>
    <tbody>
    {% for rd in readingsHistory %}
    <tr class="reading">
        <td> 20{{ rd.rp_part_y }}/{{ rd.rp_part_m }}</td>
        <td>{{ rd.tpok }}</td>
        <td>{{ rd.consumption }}</td>
    </tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}