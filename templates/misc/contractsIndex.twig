{% extends 'blank.twig' %}

{% block title %}список абонентов{% endblock %}

{% block body %}
<table>
    <thead>
    <tr>
        <th>договор</th>
        <th>наименование</th>
        <th>регион</th>
        <th>количество ТУ</th>
        <th>...</th>
    </tr>
    </thead>
    <tbody>
    {% for cntr in contractsList %}
    <tr >
        <td><a href="/login?kp={{ cntr.kp }}">{{ cntr.kp }}</a></td>
        <td>{{ cntr.npp1 ? (cntr.npp1 ~ cntr.npp2) : cntr.np1 }}</td>
        <td>{{ cntr.tip_rg ~' '~ cntr.adres1 ~' '~ cntr.tip_np ~' '~ cntr.adres2 }}</td>
        <td>{{ cntr.tucnt }}</td>
    </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}