{% extends 'layout_main.twig' %}

{% block title %}Счета и оплаты{% endblock %}

{% block content %}
<div class="contract">
    <h5>Договор  №{{ contract.kp }}, {{ contract.npp1 }} {{ contract.npp2 }}</h5>
</div>

    <table class="table paydocs">
    <thead>
    <tr>
        <th>дата</th>
        <th>расчетный период</th>
        <th>документ</th>
        <th>выставлено</th>
        <th>оплачено</th>
    </tr>
    </thead>
    <tbody>
    {% for doc in docList %}
    <tr class="">
        <td>{{ doc.date|date('d.m.Y') }}</td>
        <td>{{ doc.period }}</td>
        <td>{{ doc.doctype }} {{ doc.docno }}</td>
        <td>{{ doc.sumInv }}</td>
        <td>{{ doc.sumPay }}</td>

    </tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}