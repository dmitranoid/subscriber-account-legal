{% extends 'admin/layout_main.twig' %}

{% import 'admin/partial/form-controls.twig' as forms %}
{% set groupOptions = {
    admin: {label: 'Администратор', value: 'admin'},
    manager: {label: 'Менеджер', value: 'manager'},
    customer: {label: 'Потребитель', value: 'customer'}
} %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

    {#    debug:{{ dump(user, flash) }}#}
    {% set action = "/admin/user" . empty(user['login']) ? "" : "/" . user['login'] %}
    <form class="form col-8" role="form" method="post" action="{{ action }}">
        {{ forms.selectGroup("Категория", "code_group", user.code_group, groupOptions) }}
        {#        {{ forms.selectGroup("Категория", "code_group", flash.old('code_group', 'customer'), groupOptions) }}#}
        {{ forms.inputGroup("Логин", "login", user.login , "required", "", flash.error('login')) }}
        {{ forms.inputGroup("Пароль", "password", "", "", "password", flash.error('password')) }}
        {{ forms.inputGroup("Повторите пароль", "repassword", "", "", "password") }}
        {{ forms.inputGroup("Номер договора", "code_contract", user.code_contract, "", "", flash.error('code_contract')) }}
        {{ forms.inputGroup("Email", "email", user.email, "required", "email", flash.error('email')) }}
        {{ forms.inputGroup("Телефон", "phones", user.phones, "", "tel", flash.error('phones')) }}

        {{ forms.saveGroup("Записать", "Отменить", "/admin/users") }}
    </form>
{% endblock %}