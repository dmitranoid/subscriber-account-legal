{%  extends 'admin/layout_main.twig' %}

{% block title %}Потребитель{% endblock %}

{% block content %}
    <form class="md-form" action="/admin/user/{{ user['login'] }}">
            <label for="login">Логин</label>
            <input name="login" value="{{ user['login'] }}">


            <label for="password">Пароль</label>
            <input name="password" value="{{ user['password'] }}">

            <label for="password">Категория</label>
            <input name="password" value="{{ user['group'] }}">

            <label for="password">Номер договора</label>
            <input name="password" value="{{ user['code_contract'] }}">


        <input type="submit" class="btn btn-default" value="записать">
        <input type="button" class="btn btn-amber" value="отменить">
    </form>

{% endblock %}