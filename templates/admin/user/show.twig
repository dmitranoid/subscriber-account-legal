{% extends 'admin/layout_main.twig' %}

{% block title %}Потребитель{% endblock %}

{% block content %}
    <form class="md-form" action="/admin/user/{{ user['login'] }}">
        <div class="form-control col-8">
            <label for="login" class="col-2">Логин</label>
            <input name="login" class="col-6" value="{{ user['login'] }}">
        </div>
        <div class="form-control col-8">
            <label for="password" class="col-2">Пароль</label>
            <input name="password" class="col-6" value="{{ user['password'] }}">
        </div>
        <div class="form-control col-8">
            <label for="repassword" class="col-2">Категория</label>
            <input name="group" class="col-6" value="{{ user['group'] }}">
        </div>
        <div class="form-control col-8">
            <label for="code_contract" class="col-2">Номер договора</label>
            <input name="code_contract" class="col-6" value="{{ user['code_contract'] }}">
        </div>

        <input type="submit" class="btn btn-default" value="записать">
        <input type="button" class="btn btn-amber" value="отменить">
    </form>

{% endblock %}