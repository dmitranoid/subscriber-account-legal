{% extends 'admin/layout_main.twig' %}

{% import 'admin/partial/form-controls.twig' as forms %}
{% set groupOptions = {
    admin: {label: 'Администратор', value: 'admin'},
    manager: {label: 'Менеджер', value: 'manager'},
    customer: {label: 'Потребитель', value: 'customer'}
} %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    {{ dump(flash) }}
    {{ dump(flash.old('login')) }}
    {% set action = "/admin/user" . empty(user['login']) ? "" : "/" . user['login'] %}
    <form class="form col-8" role="form" method="post" action="{{ action }}">
        {{ forms.inputGroup("Логин", "login", flash.old('login', '') , "required") }}
        {{ forms.inputGroup("Пароль", "password", '') }}
        {{ forms.inputGroup("Повторите пароль", "repassword", "") }}
        {{ forms.selectGroup("Категория", "code_group", user["code_group"], groupOptions) }}
{#        {{ forms.inputGroup("Категория", "group", user["group"]) }}#}
        {{ forms.inputGroup("Номер договора", "code_contract", user['code_contract'], "required") }}
        {{ forms.inputGroup("Email", "email", user['email'], "required", "email") }}

        {{ forms.saveGroup }}
    </form>

{% endblock %}