{%  extends 'admin/layout_main.twig' %}

{% block content %}
    <div class="row">
        <a class="btn" href="/admin/user">Добавить пользователя</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>логин</th>
                <th>договор</th>
                <th>группа</th>
                <th>...</th>
            </tr>
        </thead>
        <tbody>
    {% for item in customersList %}
        <tr class="clickable-row">
            <td><a href="/admin/user/{{ item.login }}">{{ item.login }}</a></td>
            <td>{{ item.code_contract }}</td>
            <td>{{ item.code_group }}</td>
            <td><a href="/admin/user/{{ item.login }}/delete">X</a></td>
        </tr>
    {% endfor %}
        </tbody>
    </table>
{% endblock %}