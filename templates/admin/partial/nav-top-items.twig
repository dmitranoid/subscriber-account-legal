{% set nav = {
    contracts:{ title: "Пользователи",  link: "/admin/users", icon: "/img/icons/collaboration.svg" },
    users:    { title: "Договоры",      link: "/admin/contracts", icon: "/img/icons/crystal_oscillator.svg" },
    logout:   { title: "Выйти",         link: "/logout", icon: "/img/icons/key.svg" },
} %}

<ul class="navbar-nav ml-auto">
    {% for item in nav %}
    <li class="nav-item" >
        <a class="nav-link rounded" href="{{ item.link }}" >
            <img src="{{ item.icon }}">
            {{ item.title}}
        </a>
    </li>
    {% endfor %}
</ul>
