{% macro inputGroup(label, name, value="", params="", type="text", error) %}
    <div class="form-group row">
        <label for="{{ name }}" class="col-3">{{ label }}</label>
        <input name="{{ name }}" id="{{ name }}" class="form-control col-5" type="{{ type }}"
               value="{{ value }}" {{ params }}>
        {% if error %}
        <span class="text-danger col-4"><small>{{ error }}</small></span>
        {% endif %}
    </div>
{% endmacro %}

{% macro selectGroup(label, name, value="", selectList, params="", error) %}
    <div class="form-group row">
        <label for="{{ name }}" class="col-3">{{ label }}</label>
        <select
                name="{{ name }}"
                id="{{ name }}"
                class="browser-default custom-select col-5"
                {{ params }}
        >
            {% for option in selectList %}
                <option value="{{ option.value }}"
                        {% if value == option.value %}selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
        </select>
    </div>

{% endmacro %}
{% macro hidden(id, value) %}
    <input type="hidden" name="{{ name }}" value="value">
{% endmacro %}

{% macro saveGroup(labelSubmit = "Записать", labelCancel = "Отменить") %}
    <input type="submit" class="btn btn-default" value="{{ labelSubmit }}">
    <input type="button" class="btn btn-amber" value="{{ labelCancel }}">
{% endmacro %}
