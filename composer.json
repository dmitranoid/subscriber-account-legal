{
    "name": "bretenergo/lkprom",
    "description": "Личный кабинет пользователя (юридические лица)",
    "keywords": ["brestenergo", "web"],
    "homepage": "http://www.brestenergo.by/lkprom",
    "license": "MIT",
    "authors": [
        {
            "name": "Шляхтич Дмитрий",
            "email": "dvshlyahtich@brestenergo.by",
            "homepage": "http://www.brestenergo.by"
        }
    ],
    "require": {
        "php": ">=7.3",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "envms/fluentpdo": "^2.0",
        "hisamu/php-xbase": "1.0.5",
        "monolog/monolog": "^1.24",
        "php-di/php-di": "^6.0",
        "phpmailer/phpmailer": "^6.0",
        "slim/flash": "^0.4.0",
        "slim/psr7": "^0.5",
        "slim/slim": "^4.1",
        "slim/twig-view": "^3",
        "symfony/finder": "^5.0",
        "twig/twig": "^3.0",
        "vlucas/valitron": "v1.4.7"
    },
    "require-dev": {
        "roave/security-advisories": "dev-master",
        "codeception/codeception": "^4.1",
        "codeception/module-phpbrowser": "^1.0.0",
        "codeception/module-asserts": "^1.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S localhost:80 -t public",
        "test": "phpunit"
    }
}
